{
  "name": "alpine-asset-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.astro\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "npm run build && node scripts/verify-build.mjs",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run check && npm run test && npm run verify:build"
  },
  "dependencies": {
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.0.0",
    "globals": "^17.7.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
