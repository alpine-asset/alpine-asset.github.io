---
import BaseLayout from '../layouts/BaseLayout.astro';

const facts = [
  ['Focus', 'Energy & Utilities'],
  ['Method', 'Bottom-up · 3-Statement'],
  ['Valuation', 'DCF · SOTP · Comps'],
  ['Coverage', 'Independent'],
];
const steps = [
  { n: 'Step 01', title: 'Build the model', body: 'Reconstruct the business from filings into a full three-statement model — every forecast tied to an assumption you can audit.' },
  { n: 'Step 02', title: 'Value it to fit', body: "Apply the valuation the business calls for — discounted cash flow, sum-of-the-parts, or peer multiples — segmenting where different assets carry different economics and risk." },
  { n: 'Step 03', title: 'State the view', body: 'Land on a rating and target with the catalysts and risks that would change it — clearly enough to hold us accountable.' },
];
---

<BaseLayout
  title="About — Alpine Asset"
  description="Alpine Asset Research Group produces institutional-grade equity research free of sell-side conflicts."
  active="about"
>
  <section class="container header">
    <p class="eyebrow">About</p>
    <h1 class="h-display heading">An independent research desk, built on one principle: follow the analysis.</h1>
    <p class="sub">
      Alpine Asset Research Group produces institutional-grade equity research
      free of the conflicts that shape sell-side coverage — no banking mandates,
      no trading book, no house view to protect.
    </p>
  </section>

  <section class="container profile">
    <div class="who">
      <img src="/assets/eric-liu-headshot.jpg" alt="Eric Liu, Founder & Analyst" width="300" height="360" />
      <div class="who-meta">
        <div class="who-name">Eric Liu</div>
        <div class="who-role">Founder &amp; Analyst</div>
        <a class="who-email" href="mailto:eric.liu@alpine-asset.com">eric.liu@alpine-asset.com</a>
      </div>
    </div>

    <div class="bio">
      <div class="section-label">Profile</div>
      <p class="p1">
        Alpine Asset is led by <strong>Eric Liu</strong>, an equity research
        analyst covering the green energy and infrastructure sectors. He founded
        the firm to publish the kind of research an investor would actually want
        to read: transparent about its assumptions, honest about what it doesn't
        know, and unafraid to land on a Neutral or Sell when the numbers say so.
      </p>
      <p>
        Eric builds every report from the ground up — a full three-statement
        model, a valuation fit to the company's structure, and a thesis that
        traces cleanly from assumptions to conclusion. Coverage centers on the
        energy &amp; utilities sector, where the interplay of regulated returns,
        renewable buildout, and structural demand growth rewards deep, patient
        analysis.
      </p>
      <p class="last">
        He holds an MS in Finance (STEM) and a BBA in Finance from Baruch
        College's Zicklin School of Business — graduating with a 3.97 GPA and
        induction into Beta Gamma Sigma. Before founding Alpine, he built
        integrated financial models supporting valuation, forecasting, and
        capital-raising as a financial analyst in New York.
      </p>

      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="fact">
            <div class="fact-k">{k}</div>
            <div class="fact-v">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="how">
    <div class="container">
      <p class="eyebrow eyebrow--muted">How the research is made</p>
      <h2 class="h-display how-h">A repeatable process, applied one company at a time.</h2>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <div class="step-n">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container cta">
    <h2 class="h-display cta-h">Read the latest report, or start a conversation.</h2>
    <div class="cta-actions">
      <a class="btn btn--primary" href="/research/">View research →</a>
      <a class="btn btn--ghost" href="/contact/">Contact</a>
    </div>
  </section>
</BaseLayout>

<style>
  .header { padding-top: 76px; padding-bottom: 20px; }
  .header .heading { font-size: 46px; margin-bottom: 20px; max-width: 820px; }
  .sub { font-size: 18px; line-height: 1.6; color: var(--color-text-soft); margin: 0; max-width: 640px; }

  .profile { padding-top: 56px; padding-bottom: 56px; display: grid; grid-template-columns: 300px 1fr; gap: 64px; align-items: start; }
  .who img { width: 300px; height: 360px; object-fit: cover; object-position: 50% 25%; border: 1px solid var(--color-border); border-radius: 4px; }
  .who-meta { margin-top: 22px; }
  .who-name { font-family: var(--font-serif); font-size: 22px; font-weight: 600; color: var(--color-ink); }
  .who-role { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-muted); margin-top: 6px; }
  .who-email { display: inline-block; margin-top: 16px; color: var(--color-orange-strong); text-decoration: none; font-size: 14px; font-weight: 600; }

  .section-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--color-muted); margin-bottom: 22px; }
  .bio p { font-size: 16px; line-height: 1.72; color: var(--color-text-softer); margin: 0 0 20px; }
  .bio .p1 { font-size: 17px; color: var(--color-text); }
  .bio strong { color: var(--color-ink); font-weight: 600; }
  .bio .last { margin-bottom: 34px; }

  .facts { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--color-border-band); }
  .fact { padding: 20px 24px; border-bottom: 1px solid var(--color-border-band); }
  .fact:nth-child(odd) { border-right: 1px solid var(--color-border-band); padding-left: 0; }
  .fact:nth-child(even) { padding-right: 0; }
  .fact:nth-child(3), .fact:nth-child(4) { border-bottom: none; padding-bottom: 0; }
  .fact:nth-child(1), .fact:nth-child(2) { padding-top: 0; }
  .fact-k { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--color-muted); margin-bottom: 8px; }
  .fact-v { font-family: var(--font-serif); font-size: 17px; color: var(--color-ink); font-weight: 600; }

  .how { background: var(--color-surface-band); border-top: 1px solid var(--color-border-band); border-bottom: 1px solid var(--color-border-band); }
  .how .container { padding-top: 76px; padding-bottom: 76px; }
  .how-h { font-size: 34px; letter-spacing: -0.6px; margin: 0 0 52px; max-width: 600px; line-height: 1.2; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .step-n { font-family: var(--font-serif); font-size: 15px; font-weight: 600; color: var(--color-orange); margin-bottom: 16px; }
  .step h3 { font-family: var(--font-serif); font-size: 20px; font-weight: 600; color: var(--color-ink); margin: 0 0 12px; }
  .step p { font-size: 15px; line-height: 1.65; color: var(--color-text-softer); margin: 0; }

  .cta { padding-top: 82px; padding-bottom: 82px; display: flex; justify-content: space-between; align-items: center; gap: 40px; flex-wrap: wrap; }
  .cta-h { font-size: 32px; letter-spacing: -0.5px; margin: 0; line-height: 1.2; max-width: 560px; }
  .cta-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .profile { grid-template-columns: 1fr; gap: 40px; }
    .steps { grid-template-columns: 1fr; gap: 36px; }
    .header .heading { font-size: 36px; }
  }
</style>
