---
/**
 * Home page. The "Latest Coverage" tear-sheet card is populated automatically
 * from the newest report in the collection — publish a report and the home
 * page updates itself.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestReport, formatDate, tearSheetRows } from '../lib/reports';

const latest = await getLatestReport();
// The four cells shown on the home card, drawn from the canonical tear-sheet
// rows so the labels and formatting stay in step with the report rail.
const latestCells = latest
  ? tearSheetRows(latest.data).filter((r) =>
      ['rating', 'targetPrice', 'impliedReturn', 'method'].includes(r.key),
    )
  : [];
const approach = [
  {
    title: 'Independent & conflict-free',
    body: 'No banking relationships, no trading book, no house view to defend. Every rating reflects one thing: where the analysis leads.',
  },
  {
    title: 'Built from first principles',
    body: 'Full three-statement models and sum-of-the-parts valuation. Conclusions are traceable to assumptions you can inspect and challenge.',
  },
  {
    title: 'Energy & utilities focus',
    body: 'Deep, sector-specific coverage of the power transition — regulated utilities, renewables developers, and the demand drivers reshaping both.',
  },
];
---

<BaseLayout title="Alpine Asset — Independent Equity Research" active="home">
  <!-- HERO -->
  <section class="container hero">
    <div>
      <p class="eyebrow">Independent Equity Research</p>
      <h1 class="h-display headline">Clear-eyed research on energy &amp; utilities.</h1>
      <p class="lede">
        Alpine Asset publishes rigorous, conflict-free equity research for
        institutional investors — built on full three-statement modeling, not
        sell-side incentives.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/research/">Read the research →</a>
        <a class="btn btn--ghost" href="/about/">About Alpine</a>
      </div>
    </div>

    {latest && (
      <a class="tearsheet surface-card" href={`/research/${latest.id}/`}>
        <div class="ts-head card-head">
          <span class="ts-label overline">Latest Coverage</span>
          <span class="ts-label overline">{formatDate(latest.data.date)}</span>
        </div>
        <div class="ts-body">
          <div class="ts-ticker ticker">{latest.data.ticker} · {latest.data.exchange}</div>
          <div class="ts-company serif-value">{latest.data.company}</div>
          <div class="ts-sub">{latest.data.coverageType} · {latest.data.sector}</div>
          <div class="ts-grid">
            {latestCells.map((cell, i) => (
              <div class:list={['ts-cell', { br: i % 2 === 0, bb: i < 2 }]}>
                <div class="ts-k overline">{cell.label}</div>
                <div class="ts-v serif-value">{cell.value}</div>
              </div>
            ))}
          </div>
        </div>
        <span class="ts-foot">View full report <span class="ts-arrow">→</span></span>
      </a>
    )}
  </section>

  <!-- APPROACH -->
  <section class="section-band">
    <div class="container">
      <p class="eyebrow eyebrow--muted">The Approach</p>
      <h2 class="h-display section-h">Research written to be right, not to sell.</h2>
      <div class="grid-3">
        {approach.map((c) => (
          <div class="feature-card">
            <div class="rule"></div>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container cta-row">
    <div>
      <h2 class="h-display cta-h">Want the full analysis, or a second opinion?</h2>
      <p class="cta-p">Reach out directly — reports, models, and coverage requests.</p>
    </div>
    <a class="btn btn--dark" href="/contact/">Get in touch →</a>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding-top: 88px;
    padding-bottom: 76px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 72px;
    align-items: center;
  }
  .headline { font-size: 56px; line-height: 1.08; letter-spacing: -1.2px; margin-bottom: 26px; }
  .lede { font-size: 18px; line-height: 1.65; color: var(--color-text-soft); margin: 0 0 38px; max-width: 520px; }
  .actions { display: flex; gap: 16px; flex-wrap: wrap; }

  /* TEAR SHEET (surface + card-head + overline + ticker + serif-value shared) */
  .tearsheet {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .tearsheet:hover { box-shadow: 0 4px 16px rgba(31, 36, 38, 0.08); transform: translateY(-1px); }
  .ts-head { padding: 16px 22px; border-radius: 3px 3px 0 0; }
  .ts-label { font-size: 10px; letter-spacing: 1.8px; }
  .ts-body { padding: 24px 22px 8px; }
  .ts-ticker { margin-bottom: 6px; }
  .ts-company { font-size: 26px; line-height: 1.15; margin-bottom: 4px; }
  .ts-sub { font-size: 13px; color: var(--color-muted); margin-bottom: 22px; }
  .ts-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--color-border-soft); }
  .ts-cell { padding: 14px 0; }
  .ts-cell.br { border-right: 1px solid var(--color-border-soft); padding-right: 16px; }
  .ts-cell.bb { border-bottom: 1px solid var(--color-border-soft); }
  .ts-cell:not(.br) { padding-left: 16px; }
  .ts-k { font-size: 9.5px; letter-spacing: 1.2px; margin-bottom: 5px; }
  .ts-v { font-size: 19px; }
  .ts-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 22px;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-orange-strong);
    font-size: 13px;
    font-weight: 600;
  }
  .tearsheet:hover .ts-foot { background: var(--color-surface-hover); }
  .ts-arrow { font-family: var(--font-mono); }

  /* APPROACH (section-band + grid-3 + feature-card shared) */
  .rule { width: 38px; height: 2px; background: var(--color-orange); margin-bottom: 20px; }

  /* CTA (cta-row shared; local margin because a paragraph follows) */
  .cta-h { margin-bottom: 10px; }
  .cta-p { font-size: 16px; color: var(--color-text-softer); margin: 0; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 48px; padding-top: 60px; }
    .headline { font-size: 42px; }
    .grid-3 { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
