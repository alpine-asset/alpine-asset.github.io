---
/**
 * One page per research report, generated from the Markdown files.
 * The URL is /research/<filename>/ (e.g. /research/nextera-energy-2026/).
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportRail from '../../components/ReportRail.astro';
import { getPublishedReports } from '../../lib/reports';

export async function getStaticPaths() {
  const reports = await getPublishedReports();
  return reports.map((report) => ({
    params: { slug: report.id },
    props: { report },
  }));
}

const { report } = Astro.props;
const { data } = report;
const { Content } = await render(report);

/** Minimal inline Markdown for the lead paragraph: **bold** only. */
function renderInline(md: string): string {
  return md
    .trim()
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
function monthYear(date: Date): string {
  return date.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title={`${data.company} (${data.ticker}) — Alpine Asset`}
  description={data.summary.replace(/\*\*/g, '').trim().slice(0, 155)}
  active="research"
>
  <section class="container report">
    <ReportRail data={data} />

    <article class="body">
      <div class="tags">
        <span class="tag">{data.coverageType}</span>
        <span class="tag">{data.sector}</span>
      </div>
      <h1 class="h-display title">{data.company} — {data.rating}, {data.method} basis</h1>

      <p class="lead" set:html={renderInline(data.summary)}></p>

      <hr class="divider" />

      {data.thesis.length > 0 && (
        <>
          <div class="section-label">Investment thesis</div>
          <div class="thesis">
            {data.thesis.map((point, i) => (
              <div class="thesis-item">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              </div>
            ))}
          </div>
        </>
      )}

      {(data.catalysts.length > 0 || data.risks.length > 0) && (
        <div class="cr">
          <div class="cr-col cr-col--pos">
            <div class="cr-head">Key catalysts</div>
            <ul>{data.catalysts.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div class="cr-col">
            <div class="cr-head cr-head--neg">Key risks</div>
            <ul>{data.risks.map((r) => <li>{r}</li>)}</ul>
          </div>
        </div>
      )}

      <div class="prose extra">
        <Content />
      </div>

      <div class="cta">
        <a class="btn btn--dark" href={data.pdf} download>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1v9m0 0L4.5 6.5M8 10l3.5-3.5M2 13.5h12" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Download the full report
        </a>
        <span class="cta-meta">
          PDF{data.pdfPages ? ` · ${data.pdfPages} pages` : ''} · Published {monthYear(data.date)}
        </span>
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .report {
    padding-top: 56px;
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 64px;
  }
  .tags { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  .tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 5px 10px;
    border-radius: 2px;
  }
  .title { font-size: 34px; letter-spacing: -0.6px; line-height: 1.15; margin-bottom: 22px; }
  .lead { font-size: 17px; line-height: 1.72; color: var(--color-text); margin: 0; }
  .divider { border: none; border-top: 1px solid var(--color-border-band); margin: 34px 0; }

  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 26px;
  }
  .thesis { display: flex; flex-direction: column; gap: 26px; margin-bottom: 38px; }
  .thesis-item { display: grid; grid-template-columns: 34px 1fr; gap: 20px; align-items: start; }
  .num { font-family: var(--font-serif); font-size: 20px; font-weight: 600; color: var(--color-orange); }
  .thesis-item h3 { font-family: var(--font-serif); font-size: 19px; font-weight: 600; color: var(--color-ink); margin: 0 0 7px; }
  .thesis-item p { font-size: 15.5px; line-height: 1.65; color: var(--color-text-softer); margin: 0; }

  .cr {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border-band);
    border-radius: 3px;
    overflow: hidden;
  }
  .cr-col { padding: 22px 24px; }
  .cr-col--pos { border-right: 1px solid var(--color-border-band); }
  .cr-head {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--color-positive);
    margin-bottom: 14px;
  }
  .cr-head--neg { color: var(--color-negative); }
  .cr ul { margin: 0; padding-left: 18px; color: var(--color-text-softer); font-size: 14.5px; line-height: 1.7; }
  .cr li { margin-bottom: 8px; }
  .cr li:last-child { margin-bottom: 0; }

  .extra { margin-top: 38px; }
  .cta { margin-top: 34px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .cta-meta { font-size: 13.5px; color: var(--color-muted); }

  @media (max-width: 820px) {
    .report { grid-template-columns: 1fr; gap: 40px; }
    .cr { grid-template-columns: 1fr; }
    .cr-col--pos { border-right: none; border-bottom: 1px solid var(--color-border-band); }
  }
</style>
