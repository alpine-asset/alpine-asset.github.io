---
/**
 * Research index — lists every published report as a card.
 * Add a Markdown file to src/content/reports/ and it appears here automatically.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedReports, impliedReturn, formatPercent, formatPrice, formatDate } from '../../lib/reports';

const reports = await getPublishedReports();
---

<BaseLayout
  title="Research — Alpine Asset"
  description="Initiation reports and ongoing analysis across the energy & utilities sector."
  active="research"
>
  <section class="container header page-header">
    <p class="eyebrow">Research</p>
    <h1 class="h-display heading page-title">Published coverage</h1>
    <p class="sub page-sub">
      Initiation reports and ongoing analysis across the energy &amp; utilities
      sector. Each report ships with the full three-statement model behind it.
    </p>
  </section>

  <section class="container list">
    {reports.map((report) => {
      const d = report.data;
      return (
        <a class="row" href={`/research/${report.id}/`}>
          <div class="row-main">
            <div class="row-ticker ticker">{d.ticker} · {d.exchange}</div>
            <h2 class="row-company serif-value">{d.company}</h2>
            <p class="row-sector">{d.coverageType} · {d.sector}</p>
          </div>
          <div class="row-stats">
            <div class="stat">
              <span class="stat-k overline">Rating</span>
              <span class="stat-v serif-value">{d.rating}</span>
            </div>
            <div class="stat">
              <span class="stat-k overline">Target</span>
              <span class="stat-v serif-value">{formatPrice(d.targetPrice)}</span>
            </div>
            <div class="stat">
              <span class="stat-k overline">Implied 12M</span>
              <span class="stat-v serif-value">{formatPercent(impliedReturn(d))}</span>
            </div>
          </div>
          <div class="row-meta">
            <span class="date">{formatDate(d.date)}</span>
            <span class="arrow">→</span>
          </div>
        </a>
      );
    })}
  </section>

  <section class="container more">
    <div class="more-inner">
      <div class="dot"></div>
      <p>
        Additional energy &amp; utilities coverage is in progress.{' '}
        <a href="/contact/">Request a company</a> or ask to be notified of new reports.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Header uses shared .page-header / .page-title / .page-sub. */
  .header { padding-bottom: 44px; border-bottom: 1px solid var(--color-border-band); }
  .heading { max-width: 760px; }
  .sub { max-width: 600px; }

  .list { padding-top: 40px; padding-bottom: 8px; display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 48px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border-band);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }
  .row:hover { opacity: 0.72; }
  .row-ticker { margin-bottom: 6px; }
  .row-company { font-size: 24px; margin: 0 0 6px; }
  .row-sector { font-size: 13.5px; color: var(--color-muted); margin: 0; }

  .row-stats { display: flex; gap: 40px; }
  .stat { display: flex; flex-direction: column; gap: 5px; }
  .stat-k { font-size: 9.5px; letter-spacing: 1.2px; }
  .stat-v { font-size: 18px; }

  .row-meta { display: flex; align-items: center; gap: 18px; }
  .date { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: var(--color-muted); }
  .arrow { font-family: var(--font-mono); color: var(--color-orange); }

  .more { padding-top: 24px; padding-bottom: 88px; }
  .more-inner { border-top: 1px solid var(--color-border-band); padding-top: 34px; display: flex; align-items: center; gap: 16px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-orange); flex-shrink: 0; }
  .more p { font-size: 15px; color: var(--color-muted); margin: 0; }
  .more a { color: var(--color-orange-strong); text-decoration: none; font-weight: 600; }

  @media (max-width: 820px) {
    .row { grid-template-columns: 1fr; gap: 18px; }
    .row-stats { gap: 32px; }
  }
</style>
