---
/**
 * Site header / navigation. Ported from the old Nav.dc.html.
 * `active` highlights the current page in the nav.
 */
interface Props {
  active?: 'home' | 'research' | 'about' | 'contact';
}
const { active = 'home' } = Astro.props;

import BrandMark from './BrandMark.astro';

const links = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'research', label: 'Research', href: '/research/' },
  { key: 'about', label: 'About', href: '/about/' },
] as const;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Alpine Asset — home">
      <BrandMark size={30} />
      <span class="brand-text">
        <span class="brand-name">Alpine Asset</span>
        <span class="brand-sub">RESEARCH GROUP</span>
      </span>
    </a>
    <nav class="nav">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: active === l.key }]}>{l.label}</a>
      ))}
      <a href="/contact/" class:list={['nav-link', 'nav-cta', { active: active === 'contact' }]}>Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
  }
  .bar {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /* `color` here tints the BrandMark's base facet (currentColor). */
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--color-navy); }
  .brand-text { display: flex; flex-direction: column; line-height: 1; }
  /* .brand-name shares font/weight/size via components.css; only colour and the
     nav's tighter tracking are local. */
  .brand-name { color: var(--color-ink); letter-spacing: -0.2px; }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2.4px;
    color: var(--color-muted);
    margin-top: 3px;
  }
  .nav { display: flex; align-items: center; gap: 38px; }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    color: var(--color-text);
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: var(--color-orange-strong); }
  .nav-link.active { color: var(--color-orange-strong); font-weight: 600; }
  .nav-cta {
    padding: 9px 18px;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    color: var(--color-ink);
  }
  .nav-cta:hover { border-color: var(--color-ink); }

  /* Tablet / large phone: tighten spacing so the single-row bar still fits. */
  @media (max-width: 720px) {
    .nav { gap: 24px; }
  }

  /* Phone: the four links no longer fit beside the logo, so drop the nav onto
     its own full-width row below the brand and space the links evenly. */
  @media (max-width: 560px) {
    .bar {
      height: auto;
      min-height: 64px;
      flex-wrap: wrap;
      row-gap: 14px;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .nav {
      width: 100%;
      gap: 14px;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    .nav-link { font-size: 11px; letter-spacing: 0.8px; }
    .nav-cta { padding: 8px 14px; }
  }
</style>
