---
/**
 * Download arrow icon. Was duplicated verbatim (with a hard-coded `#fff`
 * stroke) in ReportRail.astro and the report template. The stroke inherits the
 * button's text `color` via `currentColor`, so it stays white on the primary /
 * dark buttons without naming a colour here.
 */
interface Props {
  size?: number;
}
const { size = 15 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M8 1v9m0 0L4.5 6.5M8 10l3.5-3.5M2 13.5h12"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
