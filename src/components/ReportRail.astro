---
/**
 * Sticky "tear sheet" rail shown alongside a report's body.
 * Every value comes from the report's frontmatter — nothing is hand-written here.
 */
import type { Report } from '../lib/reports';
import { impliedReturn, formatPercent, formatPrice, formatDate } from '../lib/reports';

interface Props {
  data: Report['data'];
}
const { data } = Astro.props;

const rows: Array<[string, string]> = [
  ['Rating', data.rating],
  ['Target Price', formatPrice(data.targetPrice)],
  ['Market Price', formatPrice(data.marketPrice)],
  ['Implied 12M', formatPercent(impliedReturn(data))],
  ...(data.marketCap ? ([['Market Cap', data.marketCap]] as [string, string][]) : []),
  ['Method', data.method],
];
---

<aside class="rail">
  <div class="card">
    <div class="card-head">
      <span class="label">Tear Sheet</span>
      <span class="label">{formatDate(data.date, true)}</span>
    </div>
    <div class="card-body">
      <div class="ticker">{data.ticker} · {data.exchange}</div>
      <div class="company">{data.company}</div>
      <div class="rows">
        {rows.map(([k, v]) => (
          <div class="row">
            <span class="row-k">{k}</span>
            <span class="row-v">{v}</span>
          </div>
        ))}
      </div>
    </div>
    <a class="download" href={data.pdf} download>
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 1v9m0 0L4.5 6.5M8 10l3.5-3.5M2 13.5h12" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Download PDF{data.pdfPages ? ` · ${data.pdfPages}pp` : ''}
    </a>
  </div>
  <div class="source">{data.dataSource}</div>
</aside>

<style>
  .rail { align-self: start; position: sticky; top: 32px; }
  .card { border: 1px solid var(--color-border); border-radius: 3px; overflow: hidden; }
  .card-head {
    background: var(--color-surface);
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-border-soft);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .card-body { padding: 20px; }
  .ticker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-orange-strong);
    margin-bottom: 5px;
  }
  .company {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 20px;
  }
  .rows { display: flex; flex-direction: column; }
  .row {
    display: flex;
    justify-content: space-between;
    padding: 11px 0;
    border-top: 1px solid var(--color-border-soft);
  }
  .row:last-child { border-bottom: 1px solid var(--color-border-soft); }
  .row-k { font-size: 12.5px; color: var(--color-muted); }
  .row-v { font-family: var(--font-serif); font-size: 14px; font-weight: 600; color: var(--color-ink); }
  .download {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-orange);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 15px;
    transition: background 0.15s ease;
  }
  .download:hover { background: var(--color-orange-strong); }

  /* On mobile the report collapses to a single column (see the report
     layout's 820px breakpoint), so the rail must scroll with the content
     instead of staying pinned and overlapping the article text. */
  @media (max-width: 820px) {
    .rail { position: static; top: auto; }
  }

  .source {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--color-muted-soft);
    margin-top: 14px;
    text-align: center;
  }
</style>
